{
  "name": "notification-service",
  "version": "1.0.0",
  "description": "Codingly template for Serverless Framework projects",
  "author": "Ariel Weinberger <ariel@codingly.io>",
  "license": "MIT",
  "scripts": {
    "start:local": "cross-env NODE_OPTIONS=--openssl-legacy-provider serverless offline --stage local --host 0.0.0.0",
    "deploy:local": "cross-env NODE_OPTIONS=--openssl-legacy-provider serverless deploy --stage local",
    "remove:local": "cross-env NODE_OPTIONS=--openssl-legacy-provider serverless remove --stage local"
  },
  "dependencies": {
    "@aws-sdk/client-ses": "^3.921.0",
    "aws-sdk": "^2.639.0"
  },
  "devDependencies": {
    "cross-env": "^10.1.0",
    "esbuild": "^0.23.0",
    "serverless": "^3.40.0",
    "serverless-esbuild": "^1.56.0",
    "serverless-localstack": "^1.3.1",
    "serverless-offline": "^13.9.0",
    "serverless-pseudo-parameters": "^2.5.0"
  }
}
