{
  "name": "serverless-auctions",
  "version": "1.0.0",
  "description": "Serverless Auction Platform",
  "author": "Harshana Lakshara Fernando",
  "license": "MIT",
  "scripts": {
    "local:up": "bash scripts/localstack-up.sh",
    "local:down": "docker compose down",
    "local:logs": "docker logs -f localstack",
    "start:local": "npm run offline:auction",
    "offline:auction": "cd auction-service && npm run start:local",
    "offline:auth": "cd auth-service && sls offline --stage local",
    "offline:notify": "cd notification-service && sls offline --stage local",
    "test:compose": "bash scripts/test-compose.sh",
    "test:down": "docker compose -f docker-compose.test.yml down -v"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.940.0",
    "@aws-sdk/client-s3": "^3.940.0",
    "@aws-sdk/client-ses": "^3.940.0",
    "@aws-sdk/client-sns": "^3.940.0",
    "@aws-sdk/client-sqs": "^3.940.0",
    "@aws-sdk/lib-dynamodb": "^3.940.0",
    "@aws-sdk/lib-storage": "^3.940.0"
  }
}
